HELM_SECRET_KEY=change-me-to-a-long-random-value
HELM_DATABASE_URL=postgresql+asyncpg://helm:helm@postgres:5432/helm
HELM_ALLOWED_HOSTS=["http://localhost:5173"]
HELM_SYNC_TOKEN=change-me-to-a-long-random-shared-secret
HELM_DEMO_MODE_SEED=false
# Public sign-up. Leave false; create your account with `python -m app.cli create-user EMAIL`.
HELM_ALLOW_REGISTRATION=false
# Search Console + GA4 collector (the `collector` compose service). Path to a Google
# service-account key, readable only inside that container. Empty = collector idles.
HELM_GOOGLE_CREDENTIALS_FILE=
# Hours between collector passes.
HELM_COLLECT_INTERVAL_HOURS=24
# How many days of history to pull the first time a project is collected (Search Console keeps ~16 months).
HELM_COLLECT_BACKFILL_DAYS=480

# --- Indexing, keywords and MCP ---------------------------------------------------------------
# JS-rendered pages fall back to the crawler-service /extract endpoint when both are set.
HELM_CRAWLER_URL=
HELM_CRAWLER_API_KEY=
# Keyword generator: Claude API key and model. Empty key disables the "Run generator" button.
HELM_ANTHROPIC_API_KEY=
HELM_KEYWORD_MODEL=claude-opus-5-5
# Keyword Planner (optional; needs a Google Ads developer token with Basic access and a user OAuth refresh
# token). Leave empty to use Search Console impressions as the only demand signal.
HELM_GOOGLE_ADS_DEVELOPER_TOKEN=
HELM_GOOGLE_ADS_CLIENT_ID=
HELM_GOOGLE_ADS_CLIENT_SECRET=
HELM_GOOGLE_ADS_REFRESH_TOKEN=
HELM_GOOGLE_ADS_CUSTOMER_ID=
HELM_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Kenya / English. Google geo and language constants.
HELM_KEYWORD_GEO=2404
HELM_KEYWORD_LANGUAGE=1000
# Host headers the MCP server accepts (JSON list).
HELM_MCP_ALLOWED_HOSTS=["mcp.billtoolbox.com","localhost:*","127.0.0.1:*"]

# Alert notifications (optional). Email needs all of host, from and recipients; use a sender dedicated to Helm.
HELM_SMTP_HOST=
HELM_SMTP_PORT=587
HELM_SMTP_USER=
HELM_SMTP_PASSWORD=
HELM_SMTP_FROM=
HELM_REPORT_RECIPIENTS=
HELM_TELEGRAM_BOT_TOKEN=
HELM_TELEGRAM_CHAT_ID=
HELM_ALERT_MIN_NOTIFY_HOURS=6
