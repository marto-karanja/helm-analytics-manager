HELM_SECRET_KEY=change-me-to-a-long-random-value
HELM_DATABASE_URL=postgresql+asyncpg://helm:helm@postgres:5432/helm
HELM_ALLOWED_HOSTS=["http://localhost:5173"]
HELM_SYNC_TOKEN=change-me-to-a-long-random-shared-secret
HELM_DEMO_MODE_SEED=false
# Public sign-up. Leave false; create your account with `python -m app.cli create-user EMAIL`.
HELM_ALLOW_REGISTRATION=false
# Search Console + GA4 collector (the `collector` compose service). Path to a Google
# service-account key, readable only inside that container. Empty = collector idles.
HELM_GOOGLE_CREDENTIALS_FILE=
# Hours between collector passes.
HELM_COLLECT_INTERVAL_HOURS=24
# How many days of history to pull the first time a project is collected (Search Console keeps ~16 months).
HELM_COLLECT_BACKFILL_DAYS=480
